@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Salus iT600 Gateway - Device Dashboard</h1>
    <p class="lead">Connected to your gateway - @Model.Devices.Count device(s) found</p>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <h5 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Connection Error</h5>
        <p style="white-space: pre-line;">@Model.ErrorMessage</p>
        <hr>
        <p class="mb-0 small">Please check your settings and try again, or visit the <a href="/Login" class="alert-link">Login page</a> to reconnect.</p>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row mt-4">
    <div class="col-lg-4 mb-4">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-check-circle"></i> Connection Status</h5>
            </div>
            <div class="card-body">
                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        <tr>
                            <th scope="row" class="text-end" style="width: 45%;">Host:</th>
                            <td><code>@Model.Host</code></td>
                        </tr>
                        <tr>
                            <th scope="row" class="text-end">EUID:</th>
                            <td><code>@(Model.Euid?.Length >= 16 ? Model.Euid.Substring(0, 4) + "..." + Model.Euid.Substring(12) : Model.Euid)</code></td>
                        </tr>
                        <tr>
                            <th scope="row" class="text-end">Status:</th>
                            <td><span class="badge bg-success">Connected</span></td>
                        </tr>
                        <tr>
                            <th scope="row" class="text-end">Devices:</th>
                            <td><span class="badge bg-primary">@Model.Devices.Count</span></td>
                        </tr>
                    </tbody>
                </table>
                <div class="d-grid mt-3">
                    <a asp-page="/Logout" class="btn btn-outline-danger btn-sm">Logout</a>
                </div>
            </div>
        </div>
        
        <div class="card mt-3">
            <div class="card-header bg-info text-white">
                <h6 class="mb-0"><i class="bi bi-list-ul"></i> Device Summary</h6>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Climate Devices
                        <span class="badge bg-primary rounded-pill">@Model.ClimateDevices.Count</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Sensors
                        <span class="badge bg-primary rounded-pill">@Model.SensorDevices.Count</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Switches
                        <span class="badge bg-primary rounded-pill">@Model.SwitchDevices.Count</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Binary Sensors
                        <span class="badge bg-primary rounded-pill">@Model.BinarySensorDevices.Count</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Covers
                        <span class="badge bg-primary rounded-pill">@Model.CoverDevices.Count</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    
    <div class="col-lg-8">
        @if (Model.Devices.Count == 0)
        {
            <div class="alert alert-info">
                <h5 class="alert-heading">No devices found</h5>
                <p>No devices were discovered on your Salus gateway. Please ensure your devices are properly configured and connected.</p>
            </div>
        }
        else
        {
            @* Climate Devices *@
            @if (Model.ClimateDevices.Any())
            {
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-thermometer-half"></i> Climate Devices (@Model.ClimateDevices.Count)</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var device in Model.ClimateDevices)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="card h-100 border-primary">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                @device.Name
                                                @if (device.Available)
                                                {
                                                    <span class="badge bg-success float-end">Online</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary float-end">Offline</span>
                                                }
                                            </h6>
                                            <p class="card-text small text-muted">@device.Model</p>
                                            <div class="row g-2">
                                                <div class="col-6">
                                                    <div class="border rounded p-2 text-center">
                                                        <div class="small text-muted">Current</div>
                                                        <div class="h5 mb-0">@device.CurrentTemperature@device.TemperatureUnit</div>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="border rounded p-2 text-center">
                                                        <div class="small text-muted">Target</div>
                                                        <div class="h5 mb-0">@device.TargetTemperature@device.TemperatureUnit</div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mt-2">
                                                <small>
                                                    <strong>Mode:</strong> <span class="badge bg-info">@device.HvacMode</span>
                                                    <strong>Preset:</strong> <span class="badge bg-secondary">@device.PresetMode</span>
                                                    @if (device.Humidity.HasValue)
                                                    {
                                                        <text><br /><strong>Humidity:</strong> @device.Humidity%</text>
                                                    }
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @* Sensors *@
            @if (Model.SensorDevices.Any())
            {
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-speedometer2"></i> Sensors (@Model.SensorDevices.Count)</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var device in Model.SensorDevices)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="card h-100 border-success">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                @device.Name
                                                @if (device.Available)
                                                {
                                                    <span class="badge bg-success float-end">Online</span>
                                                }
                                            </h6>
                                            <p class="card-text small text-muted">@device.Model</p>
                                            <div class="text-center border rounded p-3">
                                                <div class="h4 mb-0">@device.State @device.Unit</div>
                                                @if (!string.IsNullOrEmpty(device.DeviceClass))
                                                {
                                                    <div class="small text-muted text-capitalize">@device.DeviceClass</div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @* Switches *@
            @if (Model.SwitchDevices.Any())
            {
                <div class="card mb-4">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="bi bi-toggle-on"></i> Switches (@Model.SwitchDevices.Count)</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var device in Model.SwitchDevices)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="card h-100 border-warning">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                @device.Name
                                                @if (device.IsOn)
                                                {
                                                    <span class="badge bg-warning text-dark float-end">ON</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary float-end">OFF</span>
                                                }
                                            </h6>
                                            <p class="card-text small text-muted">@device.Model</p>
                                            <div class="text-center">
                                                @if (device.IsOn)
                                                {
                                                    <i class="bi bi-toggle-on text-warning" style="font-size: 3rem;"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-toggle-off text-secondary" style="font-size: 3rem;"></i>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @* Binary Sensors *@
            @if (Model.BinarySensorDevices.Any())
            {
                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-eye"></i> Binary Sensors (@Model.BinarySensorDevices.Count)</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var device in Model.BinarySensorDevices)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="card h-100 border-info">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                @device.Name
                                                @if (device.IsOn)
                                                {
                                                    <span class="badge bg-danger float-end">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success float-end">Inactive</span>
                                                }
                                            </h6>
                                            <p class="card-text small text-muted">@device.Model</p>
                                            <div class="text-center">
                                                @if (!string.IsNullOrEmpty(device.DeviceClass))
                                                {
                                                    <div class="small text-muted text-capitalize mb-2">@device.DeviceClass Sensor</div>
                                                }
                                                @if (device.IsOn)
                                                {
                                                    <i class="bi bi-exclamation-circle-fill text-danger" style="font-size: 2.5rem;"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-check-circle-fill text-success" style="font-size: 2.5rem;"></i>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @* Covers *@
            @if (Model.CoverDevices.Any())
            {
                <div class="card mb-4">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0"><i class="bi bi-blinds"></i> Covers (@Model.CoverDevices.Count)</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var device in Model.CoverDevices)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="card h-100 border-secondary">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                @device.Name
                                                <span class="badge bg-secondary float-end text-capitalize">@device.State</span>
                                            </h6>
                                            <p class="card-text small text-muted">@device.Model</p>
                                            <div class="text-center">
                                                <div class="mb-2">Position</div>
                                                <div class="progress" style="height: 30px;">
                                                    <div class="progress-bar" role="progressbar" style="width: @(device.Position ?? 0)%;" 
                                                         aria-valuenow="@(device.Position ?? 0)" aria-valuemin="0" aria-valuemax="100">
                                                        @(device.Position ?? 0)%
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
